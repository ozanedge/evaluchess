{
  "name": "evaluchess",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.api.json && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node tests/build.mjs && node --test --test-concurrency=1 tests/core.test.mjs tests/training.test.mjs tests/progress.test.mjs",
    "check:api": "tsc -p tsconfig.api.json",
    "test:api": "node tests/build.mjs && node --test --test-concurrency=1 tests/api.test.mjs tests/library-api.test.mjs",
    "test:ui": "node tests/ui.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1139.0",
    "@aws-sdk/lib-dynamodb": "^3.1139.0",
    "@vercel/oidc-aws-credentials-provider": "^3.3.9",
    "chess.js": "^1.4.0",
    "react": "^19.2.4",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.4",
    "stockfish": "^18.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.6.15",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright-core": "^1.58.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.4.1"
  },
  "description": "A chess playground for getting better: play five-minute games, review every move with Stockfish, and practice your mistakes."
}
