# Vercel server-side only. Never prefix these variables with VITE_.
DYNAMODB_TABLE=evaluchess-production
DYNAMODB_REGION=us-west-2
AWS_ROLE_ARN=arn:aws:iam::YOUR_ACCOUNT_ID:role/YOUR_RUNTIME_ROLE

# Local API development: use standard AWS_PROFILE or DynamoDB Local.
# Never configure DYNAMODB_ENDPOINT in Vercel.
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000
